[Unit]
Description=achiOS Canvas sync -> achiSchooNounce
After=network-online.target
Wants=network-online.target
OnFailure=achios-failure-alert@%n.service

[Service]
Type=oneshot
UMask=0077
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/achios/venv/bin/python @REPO@/scripts/canvas_scheduled.py
StandardOutput=append:%h/.local/state/achios/canvas_sync.log
StandardError=append:%h/.local/state/achios/canvas_sync.log
TimeoutStartSec=10min
