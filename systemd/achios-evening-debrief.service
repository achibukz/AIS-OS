[Unit]
Description=achiOS Evening Debrief at Midnight -> Telegram
After=network-online.target
Wants=network-online.target
OnFailure=achios-failure-alert@%n.service
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
Environment=PATH=%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/achios/venv/bin/python @REPO@/scripts/evening_debrief.py
StandardOutput=append:%h/.local/state/achios/evening_debrief.log
StandardError=append:%h/.local/state/achios/evening_debrief.log
TimeoutStartSec=5min
Restart=on-failure
RestartSec=5min
