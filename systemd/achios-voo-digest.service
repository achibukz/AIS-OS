[Unit]
Description=achiOS VOO ETF digest -> Telegram
After=network-online.target
Wants=network-online.target
OnFailure=achios-failure-alert@%n.service

[Service]
Type=oneshot
Environment=PATH=%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/achios/venv/bin/python @REPO@/scripts/voo_digest.py
StandardOutput=append:%h/.local/state/achios/voo_digest.log
StandardError=append:%h/.local/state/achios/voo_digest.log
TimeoutStartSec=5min
