[Unit]
Description=achiOS retry queued Telegram reports
After=network-online.target
Wants=network-online.target
OnFailure=achios-failure-alert@%n.service

[Service]
Type=oneshot
UMask=0077
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/achios/venv/bin/python @REPO@/scripts/notify_outbox.py deliver
StandardOutput=append:%h/.local/state/achios/outbox.log
StandardError=append:%h/.local/state/achios/outbox.log
TimeoutStartSec=5min
