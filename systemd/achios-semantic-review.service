[Unit]
Description=achiOS semantic preference review
After=network-online.target
Wants=network-online.target
OnFailure=achios-failure-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=@REPO@
EnvironmentFile=-%h/.config/achios/gemini.env
ExecStart=%h/.local/share/achios/venv/bin/python @REPO@/scripts/semantic_review.py
StandardOutput=append:%h/.local/state/achios/semantic_review.log
StandardError=append:%h/.local/state/achios/semantic_review.log
TimeoutStartSec=4min
