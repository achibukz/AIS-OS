[Unit]
Description=achiOS Active Tasks Checkpoint -> Telegram
After=network-online.target
Wants=network-online.target
OnFailure=achios-failure-alert@%n.service

[Service]
Type=oneshot
Environment=PATH=%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/achios/venv/bin/python @REPO@/scripts/tasks_digest.py
StandardOutput=append:%h/.local/state/achios/tasks_digest.log
StandardError=append:%h/.local/state/achios/tasks_digest.log
TimeoutStartSec=5min
