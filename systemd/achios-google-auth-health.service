[Unit]
Description=achiOS Google OAuth health check -> Telegram
After=network-online.target
Wants=network-online.target
OnFailure=achios-failure-alert@%n.service
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
Environment=PATH=%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/achios/venv/bin/python @REPO@/scripts/google_auth_health.py --scheduled
StandardOutput=append:%h/.local/state/achios/google_auth_health.log
StandardError=append:%h/.local/state/achios/google_auth_health.log
TimeoutStartSec=5min
Restart=on-failure
RestartSec=5min
