[Unit]
Description=achiOS Telegram bot (Claude Code channel session)
After=network-online.target
Wants=network-online.target
OnFailure=achios-failure-alert@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes

Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Environment=BOT_NAME=achios
Environment=BOT_CWD=@REPO@
# Never the default `channels/telegram` — every ordinary Claude Code session on this box
# spawns the telegram plugin's server.ts, which reads that path, kills whatever bot.pid
# names and takes the token's single getUpdates slot. The bot goes deaf. A named dir is
# only ever reached with TELEGRAM_STATE_DIR set, which only this unit does.
Environment=BOT_STATE_DIR=%h/.claude/channels/telegram-achios
# No BOT_GUARD. This one reads and writes — tasks.md, the calendar, decisions/log.md and
# commits are the job, not a hazard. Its blast radius is wider than schoolMem's by design.

ExecStart=/usr/bin/tmux -L achios new-session -d -s bot @REPO@/scripts/telegram-bot.sh
ExecStop=/usr/bin/tmux -L achios kill-server

StandardOutput=append:%h/.local/state/achios/achios_bot.log
StandardError=append:%h/.local/state/achios/achios_bot.log

[Install]
WantedBy=default.target
